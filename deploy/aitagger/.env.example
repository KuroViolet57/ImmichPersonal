# Copy to deploy/aitagger/.env (git-ignored) and adjust. Compose reads it automatically.

# Where both containers keep their model files:
#   <AITAGGER_CACHE>/hub  WD EVA02-Large + RAM++ weights (tagger container, /cache)
#   <AITAGGER_CACHE>/hf   Hugging Face cache of Qwen3.5-9B (vlm container)
# Default when unset: ~/vlm/models/aitagger. An absolute path is the safest value here.
AITAGGER_CACHE=/home/youruser/vlm/models/aitagger

# The panel derives these from its "GPU memory (GB)" setting and passes them when it starts the containers;
# the values below are only the defaults for starting by hand.
# AITAGGER_VRAM_GB=5      # memory cap of the tagger process
# AITAGGER_BATCH=16       # images per GPU micro-batch
# IDLE_EXIT_MINUTES=20    # the tagger exits after this long without a request
# AITAGGER_VLM_UTIL=0.45  # share of the GPU's total memory for the VLM, e.g. (vram_gb - 5) / total_gpu_gb
# AITAGGER_VLM_SEQS=8     # concurrent VLM requests
