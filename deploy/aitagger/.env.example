# Copy to deploy/aitagger/.env (git-ignored) and adjust. Compose reads it automatically.

# Where both containers keep their model files:
#   <AITAGGER_CACHE>/hub  WD EVA02-Large + PixAI Tagger v1.0 weights (tagger container, /cache; about 3.3 GB)
#   <AITAGGER_CACHE>/hf   Hugging Face cache of Qwen3.5-2B (vlm container; about 4.3 GB)
# Default when unset: ~/vlm/models/aitagger. An absolute path is the safest value here.
AITAGGER_CACHE=/home/youruser/vlm/models/aitagger

# The panel derives these from its settings and passes them when it starts the containers; the values below are
# the defaults for starting by hand (measured on an RTX 4090, see docs/AI-TAGGER.md, "Measured (v2)").
# AITAGGER_VRAM_GB=5      # memory cap of the tagger process (WD + PixAI); 4.2 GB are used at a micro-batch of 8
# AITAGGER_BATCH=8        # pictures per GPU micro-batch (PixAI is compute-bound: speed does not depend on it)
# IDLE_EXIT_MINUTES=20    # the tagger exits after this long without a request
# AITAGGER_VLM_UTIL=0.22  # share of the GPU's TOTAL memory for the describer (about 4.9 GB; 0.18 is the minimum)
# AITAGGER_VLM_SEQS=8     # concurrent describer requests (1-32)
