<?xml version="1.0" encoding="utf-8"?>
<!-- The panel runs on your own network / Tailscale over plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
